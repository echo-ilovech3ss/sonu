# Copy to .env for local use. Bun loads .env automatically.
PORT=8787
HOST=127.0.0.1
SONU_DB_PATH=./data/sonu.sqlite
# Required in production. Generate with: openssl rand -hex 32
SONU_ADMIN_KEY=
# Optional stable secret for admin-only tracking-code recovery copies.
# Generate with: openssl rand -hex 32
SONU_CODE_KEY=
# Razorpay test or live API keys. Keep the secret server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional WhatsApp order confirmations. Configure the account in /admin too.
WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY_URL=http://127.0.0.1:10000
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_CLIENT_ID=
WHATSAPP_SENDER_LABEL=SONU
# Public storefront URL used in WhatsApp tracking links.
PUBLIC_BASE_URL=http://localhost:8787
# NODE_ENV=production
