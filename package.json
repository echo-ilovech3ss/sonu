{
  "name": "sonu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun --hot server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test",
    "typecheck": "tsc -b --pretty false",
    "order:advance": "bun scripts/advance-order.ts",
    "whatsapp:install": "npm --prefix whatsapp-gateway install",
    "whatsapp:gateway": "npm --prefix whatsapp-gateway start"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
